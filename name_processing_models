"""Models and constants for Census name processing."""

from dataclasses import dataclass


@dataclass(frozen=True)
class NameInputColumns:
    first_names: str
    family_name: str


@dataclass(frozen=True)
class NameOutputColumns:
    first_name: str
    last_name: str
    first_name_full: str


@dataclass(frozen=True)
class NameProcessingColumns:
    """Internal columns held only within one Spark plan."""

    clean_first_names: str = "_name_clean_first_names"
    clean_family_name: str = "_name_clean_family_name"
    combined_name: str = "_name_combined"
    tokens: str = "_name_tokens"
    token_count: str = "_name_token_count"
    lookup_prefix: str = "_name_lookup_prefix"
    lookup_remainder: str = "_name_lookup_remainder"


INTERNAL_COLUMNS = NameProcessingColumns()

# Fixed contract between prepare_source_names and the normaliser.
NAME_INPUT_COLUMNS = NameInputColumns(
    first_names="_name_source_first_names",
    family_name="_name_source_family_name",
)

TITLES: tuple[str, ...] = ("MR", "MISS", "MRS", "MS", "DR", "WIFE", "JNR", "JR")

