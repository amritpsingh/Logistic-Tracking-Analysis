name: ESS1
input_variables:
  - steady_state: ess1
    dataset: census_if
    key: responses
    variables:
    # ── Spec: Metadata Mapping ───────────────────────────────────────────────
    - name: responseId            # Mandatory | string | len 18
      type: string
      is_pk: true

    - name: uoi                   # Mandatory | string | len 7–14
      type: string

    - name: collectionInstance    # Mandatory | string
      type: string
      is_pk: true

    - name: _rescued_data         # Optional | string (failed JSON parse rows)
      type: string

    - name: caseId                # Mandatory | string | len 18
      type: string
      is_pk: true

    - name: sourceSubmittedAt     # Mandatory | string | len 21
      type: string

    - name: metadata              # Optional | string (JSON – contains collectionMode)
      type: json

    - name: data                  # Mandatory | string (raw JSON blob)
      type: json

    - name: sys_create_date       # to be used as watermark
      type: timestamp

output_variables:
  - dataset: individual
    steady_state: parsing
    variables:
    # ── Spec: Metadata Mapping ───────────────────────────────────────────────
    - name: person_nbr            # Mandatory | string | len 18 | from responseId
      expression: responseId
      type: string
      is_pk: true

    - name: i_dwell_nbr           # Mandatory | string | len 7–14 | from uoi
      expression: uoi
      type: string

    - name: collection_instance   # Mandatory | string | from collectionInstance
      expression: collectionInstance
      type: string
      is_pk: true

    - name: _rescued_data          # Optional | string | from _rescued_data
      expression: _rescued_data
      type: string

    - name: i_id                  # Mandatory | string | len 18 | from caseId
      expression: caseId
      type: string
      is_pk: true

    - name: i_submitted_date_time # Mandatory | string | len 21 | from sourceSubmittedAt
      expression: sourceSubmittedAt
      type: timestamp

    - name: i_mode                # Mandatory | string | len 5–6 | Online/Phone/Visit
      expression: metadata:collectionMode
      type: string

    # ── Spec: Data Mapping – DART ────────────────────────────────────────────
    - name: i_age                 # Optional | integer | 0–120 | from IF_age_calculated
      type: short               # kept as integer: Delta does not support narrowing to tinyint on existing table
      expression: data:IF_age_calculated

    - name: i_dob_day             # Optional | numeric | 1–31 | from IF_date_of_birth.day
      type: tinyint              # Bug fix #2: spec says Type: numeric
      expression: data:IF_date_of_birth:day

    - name: i_dob_month           # Optional | numeric | 1–12 | from IF_date_of_birth.month
      type: tinyint               # Bug fix #2: spec says Type: numeric
      expression: data:IF_date_of_birth:month

    - name: i_dob_year            # Optional | numeric | from IF_date_of_birth.year
      type: short               # Bug fix #2: spec says Type: numeric
      expression: data:IF_date_of_birth:year

    - name: i_gender_predefined   # Optional | string | male/female/another
      type: array<string>
      expression: data:IF_gender_predefined:true

    - name: i_gender_text         # Optional | string | len ≤60
      type: string
      expression: data:IF_gender_text

    - name: i_gender_ayt_code      # Optional | string (classification code) – renamed in spec v1(1)
      type: string
      expression: data:IF_gender_text_AYT

    - name: i_ethnic_group_predefined  # Mandatory | string | semicolon-separated values
      type: array<string>
      expression: data:IF_ethnic_group_predefined:true

    - name: i_ethnic_group_text #  {"1": "Indian", "2": "Australian"} to ["Indian", "Australian"]
      type: array<string>
      expression: ordered_map_values:data:IF_ethnic_group_text

    - name: i_ethnic_group_ayt_1_code  # Optional | string | len ≤5 – renamed in spec v1(1)
      type: string
      expression: data:IF_ethnic_group_text_ayt_1

    - name: i_ethnic_group_ayt_2_code
      type: string
      expression: data:IF_ethnic_group_text_ayt_2

    - name: i_ethnic_group_ayt_3_code
      type: string
      expression: data:IF_ethnic_group_text_ayt_3

    - name: i_ethnic_group_ayt_4_code
      type: string
      expression: data:IF_ethnic_group_text_ayt_4

    - name: i_ethnic_group_ayt_5_code
      type: string
      expression: data:IF_ethnic_group_text_ayt_5

    - name: i_ethnic_group_ayt_6_code
      type: string
      expression: data:IF_ethnic_group_text_ayt_6

    - name: i_maori_descent       # Mandatory | string | yes/no/dont_know/refused
      type: string
      expression: data:IF_maori_descent

    - name: i_first_name_hsf       # Optional | string | len ≤60 | from IF_name.1 – renamed in spec v1(1)
      type: string
      expression: data:IF_name:1

    - name: i_family_name_hsf      # Optional | string | len ≤30 | from IF_name.2 – renamed in spec v1(1)
      type: string
      expression: data:IF_name:2

    - name: i_first_name_piped    # Optional | string | len ≤60 | from IF_piped_names.first
      type: string
      expression: data:IF_piped_names:first 

    - name: i_family_name_piped   # Optional | string | len ≤30 | from IF_piped_names.family
      type: string
      expression: data:IF_piped_names:family

    - name: i_first_names         # Optional | string | len ≤60 | from IF_names.first_names
      type: string
      expression: data:IF_names:first_names

    - name: i_family_name        # Optional | string | len ≤30 | from IF_names.family_names
      type: string
      expression: data:IF_names:family_name

    - name: i_name_confirmed      # Optional | string | yes/no/refused/dont_know
      type: string
      expression: data:IF_names_confirmed

    - name: i_ur_address_confirmed # Optional | string | yes/no/refused/dont_know
      type: string
      expression: data:IF_ur_address_confirmed

    - name: i_ur_address_predefined  # Optional | string | new_zealand/overseas
      type: string
      expression: data:IF_ur_address_predefined

    - name: i_ur_address_text     # Optional | string | len 10–120
      type: string
      expression: data:IF_ur_address_text

    - name: i_sex_at_birth        # Optional | string | Male/female/refused/dont_know
      type: string
      expression: data:IF_sex_at_birth

    - name: i_country_of_birth_predefined  # Optional | string | new zealand/overseas/… (Bug fix #3)
      type: string
      expression: data:IF_country_of_birth_predefined

    - name: i_country_of_birth_text        # Optional | string | len ≤60 (Bug fix #3)
      type: string
      expression: data:IF_country_of_birth_text

    - name: i_country_of_birth_ayt_code     # Optional | string | len 2–5 coded – renamed in spec v1(1)
      type: string
      expression: data:IF_country_of_birth_text_AYT

